<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="app_movil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:app_movil.Features.Auth.Views"
    xmlns:home="clr-namespace:app_movil.Features.Home.Views"
    Shell.NavBarIsVisible="False">

    <FlyoutItem Title="Home" Icon="dotnet_bot.png">
        <ShellContent
            Title="Main"
            ContentTemplate="{DataTemplate home:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Profile" Icon="dotnet_bot.png">
        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate auth:Welcome}"
            Route="Welcome" />
    </FlyoutItem>

</Shell>