<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app_movil.Components.Cards.RouteInfoCard">

    <Border
        BackgroundColor="{StaticResource CardBackground}"
        Stroke="{StaticResource BorderColor}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 5,5,0,0">

        <VerticalStackLayout
            Padding="16,12"
            Spacing="10">

            <!-- Encabezado -->
            <Grid ColumnDefinitions="*,*">

                <!-- Columna 0: Nombre + Conductor -->
                <VerticalStackLayout Grid.Column="0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Ruta Centro"
                        TextColor="{StaticResource TextPrimary}"/>
                    <Label
                        FontSize="12"
                        Text="Carlos Pérez"
                        TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>

                <!-- Columna 1: Placa + Horario -->
                <VerticalStackLayout Grid.Column="1">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalTextAlignment="End"
                        Text="ABC-123"
                        TextColor="{StaticResource TextPrimary}"/>
                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="End"
                        Text="06:00 AM - 07:30 AM"
                        TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>

            </Grid>

            <!-- Línea separadora -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="{StaticResource BorderColor}"/>

            <!-- Información inferior -->
            <Grid ColumnDefinitions="*,*">

                <!-- Columna 0: Paradas -->
                <VerticalStackLayout Grid.Column="0">
                    <Label
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        Text="Paradas"
                        TextColor="{StaticResource TitleColor}"/>
                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="12"
                        TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>

                <!-- Columna 1: Destino -->
                <VerticalStackLayout Grid.Column="1">
                    <Label
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        Text="Destino final"
                        TextColor="{StaticResource TitleColor}"/>
                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="Escuela"
                        TextColor="{StaticResource TextSecondary}"/>
                </VerticalStackLayout>

            </Grid>

        </VerticalStackLayout>
    </Border>

</ContentView>