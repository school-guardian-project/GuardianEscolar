<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    xmlns:layout="clr-namespace:app_movil.Components.Layout"
    xmlns:cards="clr-namespace:app_movil.Components.Cards"
    xmlns:inputs="clr-namespace:app_movil.Components.Inputs"
    xmlns:buttons="clr-namespace:app_movil.Components.Buttons"
    x:Class="app_movil.Features.Home.Views.MainPage"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Mapa con controles flotantes -->
        <Grid Grid.Row="0">

            <mapsui:MapControl
                x:Name="RouteMap"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"/>

            <!-- Barra superior flotante -->
            <Grid
                Padding="10,15,10,0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="5"
                VerticalOptions="Start">

                <inputs:SearchInput
                    Grid.Column="0"
                    HeightRequest="40"/>

                <buttons:NotificationButton
                    Grid.Column="1"
                    WidthRequest="50"
                    HeightRequest="50"/>

            </Grid>

        </Grid>

        <cards:RouteInfoCard Grid.Row="1"/>

        <layout:BottomTabBar Grid.Row="2"/>

    </Grid>

</ContentPage>