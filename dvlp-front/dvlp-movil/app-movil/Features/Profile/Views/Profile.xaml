<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:app_movil.Components.Inputs"
    xmlns:layout="clr-namespace:app_movil.Components.Layout"
    x:Class="app_movil.Features.Profile.Views.Profile">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <components:SettingsItem
                    Title="Mis datos"
                    />

                <components:SettingsItem
                    Title="Mi familia"
                    />

                <components:SettingsItem
                    Title="Seguridad"
                    />

                <components:SettingsItem
                    Title="Políticas de privacidad"
                    />

                <components:SettingsItem
                    Title="Sobre nosotros"
                    />

            </VerticalStackLayout>

        </ScrollView>

        <layout:BottomTabBar
            Grid.Row="1"
            TabSelected="OnTabSelected"/>

    </Grid>

</ContentPage>