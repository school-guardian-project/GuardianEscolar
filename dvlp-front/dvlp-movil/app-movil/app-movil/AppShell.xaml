<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="app_movil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:app_movil.Features.Auth.Views"
    xmlns:home="clr-namespace:app_movil.Features.Home.Views"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Welcome"
        ContentTemplate="{DataTemplate auth:Welcome}"
        Route="Welcome" />

    <ShellContent
        Title="MainPage"
        ContentTemplate="{DataTemplate home:MainPage}"
        Route="MainPage" />

</Shell>
    
    