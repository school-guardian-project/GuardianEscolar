<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app_movil.Components.InputField"
             x:Name="this">

    <VerticalStackLayout Spacing="4">

        <!-- Label -->
        <Label
            Text="{Binding LabelText, Source={x:Reference this}}"
            FontSize="13"
            TextColor="{StaticResource TextSecondary}"
            Margin="-1,0,0,1"/>

        <!-- Input -->
        <Border
            BackgroundColor="{StaticResource CardSecondaryBackground}"
            StrokeShape="RoundRectangle 10"
            Stroke="{StaticResource BorderColor}"
            Padding="10,0"
            HeightRequest="50"
            WidthRequest="330">

            <Entry
                Placeholder="{Binding Placeholder, Source={x:Reference this}}"
                Keyboard="{Binding Keyboard, Source={x:Reference this}}"
                IsPassword="{Binding IsPassword, Source={x:Reference this}}"
                BackgroundColor="Transparent"
                PlaceholderColor="{StaticResource InputPlaceholder}"
                TextColor="{StaticResource TextPrimary}"
                VerticalOptions="Center"
                Text="{Binding Text, Source={x:Reference this}}"/>

        </Border>

    </VerticalStackLayout>

</ContentView>
