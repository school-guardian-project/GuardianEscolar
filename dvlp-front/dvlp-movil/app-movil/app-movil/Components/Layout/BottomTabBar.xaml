<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app_movil.Components.Layout.BottomTabBar"
             xmlns:services="clr-namespace:app_movil.Services">

    <Border BackgroundColor="#6B5ED6"
            StrokeThickness="0"
            HeightRequest="72">

        <Grid ColumnDefinitions="*,*,*"
              VerticalOptions="Center">

            <!-- TAB 1: Rutas -->
            <Border Grid.Column="0"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="4">
                    <Label Text="route"
                           FontFamily="MaterialSymbolsOutlined"
                           FontSize="28"
                           TextColor="White"
                           WidthRequest="28"
                           HeightRequest="28"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center"/>
                    <Label Text="{services:Translation Key=Route}"
                           FontSize="10" TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRutasTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- TAB 2: Ubicacion -->
            <Border Grid.Column="1"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="4">
                    <Label Text="location_on"
                           FontFamily="MaterialSymbolsOutlined"
                           FontSize="28"
                           TextColor="White"
                           WidthRequest="28"
                           HeightRequest="28"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center"/>
                    <Label Text="{services:Translation Key=Location}"
                           FontSize="10" TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUbicacionTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- TAB 3: Perfil -->
            <Border Grid.Column="2"
                    BackgroundColor="Transparent"
                    StrokeThickness="0">
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="4">
                    <Label Text="person"
                           FontFamily="MaterialSymbolsOutlined"
                           FontSize="28"
                           TextColor="White"
                           WidthRequest="28"
                           HeightRequest="28"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Center"/>
                    <Label Text="{services:Translation Key=Profile}"
                           FontSize="10" TextColor="White"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPerfilTapped"/>
                </Border.GestureRecognizers>
            </Border>

        </Grid>
    </Border>

</ContentView>
