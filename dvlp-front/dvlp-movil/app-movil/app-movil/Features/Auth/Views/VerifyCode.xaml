<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:app_movil.Services"
             x:Class="app_movil.Features.Auth.Views.VerifyCode"
             xmlns:inputs="clr-namespace:app_movil.Components.Inputs"
             xmlns:components="clr-namespace:app_movil.Components"
             
             BackgroundColor="{StaticResource Background}">


    <VerticalStackLayout
        Padding="30"
        Spacing="10">


        <BoxView
 
            Margin="-30,-30,-30,15"/>

        <Label
            Text="{services:Translation Key=ResetPassword}"
            FontSize="25"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            TextColor="{StaticResource TitleColor}"
            Margin="0,30,0,0"/>

        <Label
            Text="{services:Translation Key=CodeEmail}"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            FontSize="13"
            TextColor="{StaticResource TextSecondary}"
            Margin="0,0,0,0"/>


        <inputs:CodeInput />

            <Label
                 Text="{services:Translation Key=TransferCode}"  
                 HorizontalOptions="Center"
                 HorizontalTextAlignment="Center"
                 TextColor="{StaticResource TitleColor}"
                 Margin="0,40,0,0"
            />

        <components:PrimaryButton
                Text="{services:Translation Key=SendCode}"
                Margin="0,20,0,0"
                Clicked="OnSendCodeClicked"/>
            </VerticalStackLayout>

</ContentPage>