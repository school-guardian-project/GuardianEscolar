<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:app_movil.Services"
    x:Class="app_movil.Features.Auth.Views.Welcome"
    xmlns:inputs="clr-namespace:app_movil.Components.Inputs"
    xmlns:components="clr-namespace:app_movil.Components"
    BackgroundColor="{StaticResource Background}"
    NavigationPage.HasNavigationBar="False">


    <ScrollView>
        <VerticalStackLayout
            Padding="50"
            Spacing="15"
            Margin="0,0,0,100"
            VerticalOptions="Center">

            <!-- Icono -->
            <Label
                Text="🛡️"
                FontSize="70"
                HorizontalOptions="Center"/>
             
            <!-- Título app 
            <Label
                Text="Guardian Escolar"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="{StaticResource TitleColor}"
                Margin="0,10,0,40"/>
                -->

            <!-- Iniciar Sesión -->
            <Label
                Text="{services:Translation Key=Login}"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="{StaticResource TitleColor}"
                Margin="0,50,0,10"/>

            <inputs:InputField
                LabelText="{services:Translation Key=Email}"
                Placeholder="ejemplo@gmail.com"
                Keyboard="Email"
                Text="{Binding Email}"/>

            <inputs:InputField
                LabelText="{services:Translation Key=Password}"
                Placeholder="••••••••"
                IsPassword="True"
                Text="{Binding Password}"/>

            <!-- Olvidó contraseña -->
            <Label
                Text="{services:Translation Key=ForgotPassword}"
                FontSize="13"
                TextColor="{StaticResource Primary}"
                Margin="-20,-5,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                </Label.GestureRecognizers>
            </Label>
            <!-- Botón -->
            <components:PrimaryButton
                Text="{services:Translation Key=Enter}"
                Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
