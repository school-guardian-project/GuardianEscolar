# IP local de tu máquina en la red Wi-Fi. Debe ser la misma en las dos claves:
# la que Metro anuncia al celular (REACT_NATIVE_PACKAGER_HOSTNAME) y la que la
# app usa para llamar al API Gateway.
EXPO_LAN_IP=
EXPO_PUBLIC_API_URL=
# URL LAN del microservicio ms-forgot-information publicado en el puerto 8091.
# Reemplaza localhost por la IP Wi-Fi de la computadora para acceder desde el móvil.
EXPO_PUBLIC_FORGOT_INFORMATION_API_URL=
