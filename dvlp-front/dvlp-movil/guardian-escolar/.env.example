# IP local de tu máquina en la red Wi-Fi. Debe ser la misma en las dos claves:
# la que Metro anuncia al celular (REACT_NATIVE_PACKAGER_HOSTNAME) y la que la
# app usa para llamar al API Gateway. Déjalas vacías y la app falla con un error
# claro en lugar de una URL rota.
EXPO_LAN_IP=192.168.101.13
EXPO_PUBLIC_API_URL=http://192.168.101.13:8080
